{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "site": "analise-acoes-b3",
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "iniciar_servidor_mobile.bat",
      "**/*.csv",
      "**/*.ofx",
      "**/*.qif",
      "**/*.xls",
      "**/*.xlsx",
      "**/extrato*",
      "**/fatura*"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
