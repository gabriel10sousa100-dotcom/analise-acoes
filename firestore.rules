rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Backup/sincronização do Controle Financeiro + Carteira: cada usuário
    // só pode ler/escrever o próprio documento (chave = seu uid do Google).
    match /b3_sync/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
